{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-app",
  "version": "0.1.2",
  "identifier": "dev.dsh.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/dsh-core"],
    "resources": {
      "../runtime": "runtime",
      "../npm-cli": "npm-cli"
    },
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    },
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
